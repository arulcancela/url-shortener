# ----------------------------------------------------------------------------
# Base de datos
# ----------------------------------------------------------------------------
# Desarrollo local (SQLite). El provider del schema se controla con esta URL.
DATABASE_URL="file:./dev.db"

# Producción (Postgres en Neon/Supabase). Cambia también el provider del schema
# a "postgresql" (ver README > "Cambiar a Postgres en producción").
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
# URL pública usada para construir los enlaces cortos.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Autenticación (NextAuth + GitHub OAuth)
# ----------------------------------------------------------------------------
# Crea una OAuth App en https://github.com/settings/developers
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# Si no defines estas variables, la app funciona en modo anónimo (sin login).
GITHUB_ID=""
GITHUB_SECRET=""

# Secreto para firmar los JWT de sesión. Genera uno con:
#   openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Rate limiting (opcional). Sin estas variables se usa un limitador en memoria.
# Con Upstash Redis (tier gratuito) el límite se comparte entre instancias.
# ----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ----------------------------------------------------------------------------
# Analítica geográfica (opcional en local; Vercel la inyecta automáticamente).
# ----------------------------------------------------------------------------
# Se lee del header "x-vercel-ip-country" proporcionado por Vercel.
