# ----------------------------------------------------------------------------
# Variables de entorno para PRODUCCIÓN (Vercel + Neon + GitHub OAuth)
# ----------------------------------------------------------------------------
# Copia estos nombres en Vercel → Settings → Environment Variables.
# NO subas este archivo con valores reales al repositorio.

# Base de datos Postgres (Neon/Supabase). Ojo: provider del schema en "postgresql".
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# URL pública de producción (sin barra final).
NEXT_PUBLIC_APP_URL="https://tu-app.vercel.app"

# ----------------------------------------------------------------------------
# NextAuth
# ----------------------------------------------------------------------------
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="REEMPLAZA_CON_UN_SECRETO_ALEATORIO"
NEXTAUTH_URL="https://tu-app.vercel.app"

# OAuth App de GitHub (https://github.com/settings/developers)
#   Homepage URL:              https://tu-app.vercel.app
#   Authorization callback URL: https://tu-app.vercel.app/api/auth/callback/github
GITHUB_ID="tu-client-id"
GITHUB_SECRET="tu-client-secret"

# ----------------------------------------------------------------------------
# Rate limiting (opcional, recomendado en producción)
# ----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="tu-token"
